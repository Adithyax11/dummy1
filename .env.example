# --- Postgres ---
POSTGRES_USER=testbed
POSTGRES_PASSWORD=testbed
POSTGRES_DB=testbed
POSTGRES_PORT=5432          # change to 5433 if 5432 is taken on your machine

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Host ports ---
FRONTEND_PORT=8080          # change to 8081 if 8080 is taken
GATEWAY_PORT=8000

# --- Payment behavior (what the payment-service does to requests) ---
# FAILURE_RATE: 0.0 to 1.0, share of charges that return 402 declined
# MIN/MAX_LATENCY_MS: random delay added to every charge
#
# Presets:
#   calm      FAILURE_RATE=0.02  MIN_LATENCY_MS=20   MAX_LATENCY_MS=100
#   default   FAILURE_RATE=0.10  MIN_LATENCY_MS=50   MAX_LATENCY_MS=500
#   chaotic   FAILURE_RATE=0.30  MIN_LATENCY_MS=200  MAX_LATENCY_MS=2000
FAILURE_RATE=0.10
MIN_LATENCY_MS=50
MAX_LATENCY_MS=500